<Application x:Class="Umbra.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Umbra.App"
             ThemeMode="Dark"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <local:UrlToImageConverter x:Key="Img"/>
            <local:BoolToVisibilityConverter x:Key="BoolVis"/>
            <local:BoolToVisibilityConverter x:Key="BoolVisInv" Invert="True"/>
            <local:EmptyToVisibilityConverter x:Key="EmptyVis"/>
            <local:PositiveToVisibilityConverter x:Key="PositiveVis"/>
            <local:InitialConverter x:Key="Initial"/>

            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
            <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

            <!-- ============ Monochrome palette ============ -->
            <SolidColorBrush x:Key="WindowBg" Color="#050506"/>
            <SolidColorBrush x:Key="Surface1" Color="#0DFFFFFF"/>
            <SolidColorBrush x:Key="Surface2" Color="#17FFFFFF"/>
            <SolidColorBrush x:Key="Surface3" Color="#26FFFFFF"/>
            <SolidColorBrush x:Key="HairlineBrush" Color="#17FFFFFF"/>
            <SolidColorBrush x:Key="HairlineStrong" Color="#30FFFFFF"/>
            <SolidColorBrush x:Key="TextBrush" Color="#F5F5F7"/>
            <SolidColorBrush x:Key="MutedBrush" Color="#A1A1A6"/>
            <SolidColorBrush x:Key="FaintBrush" Color="#6E6E73"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="OnAccentBrush" Color="#000000"/>
            <SolidColorBrush x:Key="GlassBrush" Color="#E61A1A1C"/>
            <SolidColorBrush x:Key="PopupBrush" Color="#F71E1E20"/>

            <!-- Keeps the remaining built-in Fluent controls grayscale. -->
            <Color x:Key="SystemAccentColor">#F5F5F7</Color>
            <Color x:Key="SystemAccentColorPrimary">#F5F5F7</Color>
            <Color x:Key="SystemAccentColorSecondary">#E3E3E6</Color>
            <Color x:Key="SystemAccentColorTertiary">#C7C7CC</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#F5F5F7"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E3E3E6"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#C7C7CC"/>
            <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#F5F5F7"/>
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#0B0B0C"/>
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#1A1A1C"/>
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#F5F5F7"/>

            <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>
            <QuinticEase x:Key="EaseOutStrong" EasingMode="EaseOut"/>
            <BackEase x:Key="Spring" EasingMode="EaseOut" Amplitude="0.45"/>

            <!-- ============ Typography ============ -->
            <Style x:Key="LargeTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
                <Setter Property="FontSize" Value="34"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style x:Key="H1" TargetType="TextBlock" BasedOn="{StaticResource LargeTitle}"/>
            <Style x:Key="H2" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Style>
            <Style x:Key="H3" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Style>
            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            </Style>
            <Style x:Key="Eyebrow" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Margin" Value="4,16,0,7"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            </Style>
            <Style x:Key="Icon" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- ============ Surfaces ============ -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Surface1}"/>
                <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="22"/>
            </Style>
            <Style x:Key="Divider" TargetType="Rectangle">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Fill" Value="{StaticResource HairlineBrush}"/>
            </Style>

            <!-- ============ Buttons ============ -->
            <!-- Pill button: BorderBrush is the colour of the hover veil. -->
            <ControlTemplate x:Key="PillButtonTemplate" TargetType="ButtonBase">
                <Grid RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="S"/>
                    </Grid.RenderTransform>
                    <local:Pill x:Name="Bd" Background="{TemplateBinding Background}"/>
                    <local:Pill x:Name="Veil" Background="{TemplateBinding BorderBrush}" Opacity="0"/>
                    <local:Pill x:Name="Ring" BorderBrush="#99FFFFFF" BorderThickness="2" Margin="-4" Opacity="0"/>
                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0:0:0.14"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleX" To="0.955" Duration="0:0:0.09" EasingFunction="{StaticResource EaseOut}"/>
                                    <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleY" To="0.955" Duration="0:0:0.09" EasingFunction="{StaticResource EaseOut}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.32" EasingFunction="{StaticResource Spring}"/>
                                    <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.32" EasingFunction="{StaticResource Spring}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.35"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="AccentButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="BorderBrush" Value="Black"/>
                <Setter Property="Padding" Value="24,11"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="FontSize" Value="14.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template" Value="{StaticResource PillButtonTemplate}"/>
            </Style>

            <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Background" Value="{StaticResource Surface2}"/>
                <Setter Property="BorderBrush" Value="White"/>
                <Setter Property="FontWeight" Value="Medium"/>
            </Style>

            <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="FontSize" Value="13.5"/>
            </Style>

            <!-- Round icon button -->
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="White"/>
                <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Width" Value="42"/>
                <Setter Property="Height" Value="42"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template" Value="{StaticResource PillButtonTemplate}"/>
            </Style>
            <Style x:Key="GlassIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Background" Value="{StaticResource Surface2}"/>
            </Style>

            <!-- Row / tile: rounded rectangle that lights up on hover -->
            <Style x:Key="TileButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="S"/>
                                </Grid.RenderTransform>
                                <Border Background="{TemplateBinding Background}" CornerRadius="16"/>
                                <Border x:Name="Veil" Background="White" CornerRadius="16" Opacity="0"/>
                                <Border x:Name="Ring" BorderBrush="#80FFFFFF" BorderThickness="1.5" CornerRadius="16" Opacity="0"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0:0:0.14"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.26"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleX" To="0.985" Duration="0:0:0.09"/>
                                                <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleY" To="0.985" Duration="0:0:0.09"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.24" EasingFunction="{StaticResource EaseOut}"/>
                                                <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.24" EasingFunction="{StaticResource EaseOut}"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Artwork card: no chrome, lifts towards the viewer on hover -->
            <Style x:Key="CardButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent" RenderTransformOrigin="0.5,0.45">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="S"/>
                                </Grid.RenderTransform>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                <Border x:Name="Ring" BorderBrush="#99FFFFFF" BorderThickness="2" CornerRadius="16" Margin="-5" Opacity="0"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleX" To="1.045" Duration="0:0:0.28" EasingFunction="{StaticResource EaseOutStrong}"/>
                                                <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleY" To="1.045" Duration="0:0:0.28" EasingFunction="{StaticResource EaseOutStrong}"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.36" EasingFunction="{StaticResource EaseOut}"/>
                                                <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.36" EasingFunction="{StaticResource EaseOut}"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ Navigation ============ -->
            <Style x:Key="NavTab" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="GroupName" Value="nav"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border Background="Transparent" CornerRadius="19" Padding="17,0" Height="38">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}" FontSize="14.5"
                                               VerticalAlignment="Center" Margin="0,1,9,0"/>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NavIcon" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="GroupName" Value="nav"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid>
                                <Border x:Name="Bd" Background="White" CornerRadius="21" Opacity="0"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.08"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.15"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PillToggle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,0,8,8"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid>
                                <Border x:Name="Bd" Background="{StaticResource Surface2}" CornerRadius="18"/>
                                <Border x:Name="On" Background="{StaticResource AccentBrush}" CornerRadius="18" Opacity="0"/>
                                <ContentPresenter Margin="18,8"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface3}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SegmentItem" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ Switch (CheckBox) ============ -->
            <Style x:Key="Switch" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Width="48" Height="28" Background="Transparent">
                                <Border CornerRadius="14" Background="#33FFFFFF"/>
                                <Border x:Name="On" CornerRadius="14" Background="White" Opacity="0"/>
                                <Border x:Name="Ring" CornerRadius="16" BorderBrush="#80FFFFFF" BorderThickness="2" Margin="-4" Opacity="0"/>
                                <Grid Width="22" Height="22" HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="T"/>
                                    </Grid.RenderTransform>
                                    <Ellipse Fill="White"/>
                                    <Ellipse x:Name="Knob" Fill="Black" Opacity="0"/>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="T" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.26" EasingFunction="{StaticResource EaseOutStrong}"/>
                                                <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="T" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.26" EasingFunction="{StaticResource EaseOutStrong}"/>
                                                <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ Text fields ============ -->
            <ControlTemplate x:Key="FieldTemplate" TargetType="Control">
                <Grid>
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12"
                            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"/>
                    <Border x:Name="Focus" CornerRadius="12" BorderBrush="#B3FFFFFF" BorderThickness="1.5" Opacity="0"/>
                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                  Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2}"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Focus" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Focus" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.5"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style TargetType="TextBox">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Background" Value="{StaticResource Surface1}"/>
                <Setter Property="CaretBrush" Value="White"/>
                <Setter Property="SelectionBrush" Value="White"/>
                <Setter Property="SelectionOpacity" Value="0.28"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="FontSize" Value="14.5"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="MinHeight" Value="44"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template" Value="{StaticResource FieldTemplate}"/>
            </Style>
            <Style TargetType="PasswordBox">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Background" Value="{StaticResource Surface1}"/>
                <Setter Property="CaretBrush" Value="White"/>
                <Setter Property="SelectionBrush" Value="White"/>
                <Setter Property="SelectionOpacity" Value="0.28"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="FontSize" Value="14.5"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="MinHeight" Value="44"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template" Value="{StaticResource FieldTemplate}"/>
            </Style>

            <!-- ============ Slider ============ -->
            <Style x:Key="SliderFill" TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent">
                                <Border Height="4" CornerRadius="2" Background="White" VerticalAlignment="Center" Margin="0,0,-4,0"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SliderRest" TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SliderThumb" TargetType="Thumb">
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Background="Transparent">
                                <Ellipse Fill="White" Width="13" Height="13" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="S"/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.45" Color="Black"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleX" To="1.22" Duration="0:0:0.14"/>
                                                <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleY" To="1.22" Duration="0:0:0.14"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="Slider">
                <Setter Property="Height" Value="22"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid Background="Transparent">
                                <Border Height="4" CornerRadius="2" Background="#38FFFFFF" VerticalAlignment="Center"/>
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFill}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderRest}"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource SliderThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ Progress bar ============ -->
            <Style TargetType="ProgressBar">
                <Setter Property="Height" Value="3"/>
                <Setter Property="MinHeight" Value="2"/>
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Background" Value="#2EFFFFFF"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="1.5"/>
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="1.5" HorizontalAlignment="Left"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ Scrolling: thin overlay bars that appear on hover ============ -->
            <Style x:Key="ScrollPage" TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ScrollThumb" TargetType="Thumb">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Background="Transparent">
                                <Border x:Name="Bd" Background="#52FFFFFF" CornerRadius="3" Margin="3"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#8CFFFFFF"/>
                                    <Setter TargetName="Bd" Property="Margin" Value="2"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#B3FFFFFF"/>
                                    <Setter TargetName="Bd" Property="Margin" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Width" Value="12"/>
                <Setter Property="MinWidth" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="Height" Value="12"/>
                        <Setter Property="MinHeight" Value="12"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="Transparent">
                                        <Track x:Name="PART_Track">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPage}"/>
                                            </Track.DecreaseRepeatButton>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPage}"/>
                                            </Track.IncreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource ScrollThumb}"/>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="ScrollViewer">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid Background="Transparent">
                                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}"
                                                        CanContentScroll="{TemplateBinding CanContentScroll}"/>
                                <ScrollBar x:Name="PART_VerticalScrollBar" Orientation="Vertical" HorizontalAlignment="Right" Opacity="0"
                                           Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                           Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                                <ScrollBar x:Name="PART_HorizontalScrollBar" Orientation="Horizontal" VerticalAlignment="Bottom" Opacity="0"
                                           Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                                           Value="{TemplateBinding HorizontalOffset}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PART_VerticalScrollBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="PART_HorizontalScrollBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PART_VerticalScrollBar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.5" BeginTime="0:0:0.4"/>
                                                <DoubleAnimation Storyboard.TargetName="PART_HorizontalScrollBar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.5" BeginTime="0:0:0.4"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ Lists ============ -->
            <Style TargetType="ListBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"
                                          CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Padding" Value="10,3"/>
                <Setter Property="Margin" Value="0,1,10,1"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid Background="Transparent">
                                <Border x:Name="Hover" Background="White" CornerRadius="12" Opacity="0"/>
                                <Border x:Name="Sel" Background="White" CornerRadius="12" Opacity="0"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Hover" Property="Opacity" Value="0.06"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="0.13" Duration="0:0:0.16"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ Tooltip & menus ============ -->
            <Style TargetType="ToolTip">
                <Setter Property="LayoutTransform" Value="{Binding Transform, Source={x:Static local:Ui.I}}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="HasDropShadow" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{StaticResource PopupBrush}" BorderBrush="{StaticResource HairlineStrong}" BorderThickness="1"
                                    CornerRadius="9" Padding="11,6" Margin="4">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ContextMenu">
                <Setter Property="LayoutTransform" Value="{Binding Transform, Source={x:Static local:Ui.I}}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="HasDropShadow" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border x:Name="Root" Margin="14" Background="{StaticResource PopupBrush}" BorderBrush="{StaticResource HairlineStrong}"
                                    BorderThickness="1" CornerRadius="14" Padding="6" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="MenuScale"/>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.55" Color="Black"/>
                                </Border.Effect>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14"/>
                                                <DoubleAnimation Storyboard.TargetName="MenuScale" Storyboard.TargetProperty="ScaleX" From="0.95" To="1" Duration="0:0:0.2" EasingFunction="{StaticResource EaseOut}"/>
                                                <DoubleAnimation Storyboard.TargetName="MenuScale" Storyboard.TargetProperty="ScaleY" From="0.95" To="1" Duration="0:0:0.2" EasingFunction="{StaticResource EaseOut}"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="MenuItem">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Padding" Value="10,8,16,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" MinWidth="190">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                               VerticalAlignment="Center" Visibility="Hidden"/>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{StaticResource FaintBrush}"
                                               Margin="26,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Rectangle Height="1" Margin="10,5" Fill="{StaticResource HairlineStrong}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ Data templates ============ -->
            <DataTemplate x:Key="CategoryTemplate">
                <Grid Height="34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" Margin="2,0,12,0" FontSize="15"
                               Foreground="{StaticResource MutedBrush}" Visibility="{Binding Icon, Converter={StaticResource EmptyVis}}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="14"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="11" Margin="0,0,7,0" Foreground="{StaticResource FaintBrush}"
                                   Visibility="{Binding IsLocked, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="{Binding Count}" FontSize="12" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <!-- Channel row (player list, search results) -->
            <DataTemplate x:Key="ChannelTemplate">
                <Grid Height="52">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Num}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"
                               Margin="0,0,12,0" Foreground="{StaticResource FaintBrush}"/>
                    <Border Grid.Column="1" Width="62" Height="40" CornerRadius="9" Background="#12FFFFFF">
                        <local:FadeImage Source="{Binding Logo, Converter={StaticResource Img}, ConverterParameter=128}"
                                         Stretch="Uniform" Margin="6" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="14.5" VerticalAlignment="Center"
                               Margin="14,0,8,0" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" ToolTip="{local:T 'Catch-up disponible'}" FontSize="13"
                                   Foreground="{StaticResource FaintBrush}" Margin="5,0"
                                   Visibility="{Binding HasArchive, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE735;" Foreground="{StaticResource TextBrush}" FontSize="12"
                                   Margin="5,0" Visibility="{Binding IsFavorite, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <!-- Channel row in Live TV: a play button appears on hover -->
            <DataTemplate x:Key="ChannelRowTemplate">
                <Grid Height="54">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Num}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"
                               Margin="0,0,12,0" Foreground="{StaticResource FaintBrush}"/>
                    <Border Grid.Column="1" Width="64" Height="42" CornerRadius="9" Background="#12FFFFFF">
                        <local:FadeImage Source="{Binding Logo, Converter={StaticResource Img}, ConverterParameter=128}"
                                         Stretch="Uniform" Margin="6" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="14.5" VerticalAlignment="Center"
                               Margin="14,0,8,0" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" ToolTip="{local:T 'Catch-up disponible'}" FontSize="13"
                                   Foreground="{StaticResource FaintBrush}" Margin="5,0"
                                   Visibility="{Binding HasArchive, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE735;" Foreground="{StaticResource TextBrush}" FontSize="12"
                                   Margin="5,0" Visibility="{Binding IsFavorite, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                    <Button x:Name="PlayNow" Grid.Column="4" Style="{StaticResource AccentButton}" Tag="play" Width="34" Height="34" Padding="0"
                            Margin="8,0,0,0" FontFamily="{StaticResource IconFont}" FontSize="12" Content="&#xF5B0;" ToolTip="{local:T 'Ver ahora'}"
                            Focusable="False" Opacity="0" IsHitTestVisible="False"/>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                        <Setter TargetName="PlayNow" Property="IsHitTestVisible" Value="True"/>
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="PlayNow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="PlayNow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Channel card (home shelves) -->
            <DataTemplate x:Key="ChannelCardTemplate">
                <Button Style="{StaticResource CardButton}" Width="188" Margin="7,8" ToolTip="{Binding Name}">
                    <StackPanel>
                        <local:AspectBox Ratio="0.5625" CornerRadius="14">
                            <Grid>
                                <Rectangle Fill="#14FFFFFF"/>
                                <local:FadeImage Source="{Binding Logo, Converter={StaticResource Img}, ConverterParameter=256}"
                                                 Stretch="Uniform" Margin="30,20" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </local:AspectBox>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="3,10,3,0" FontSize="13.5"/>
                    </StackPanel>
                </Button>
            </DataTemplate>

            <!-- EPG row -->
            <DataTemplate x:Key="EpgTemplate">
                <Grid x:Name="Root" Margin="0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Start, StringFormat=HH:mm}" FontWeight="SemiBold" FontSize="13.5"/>
                        <TextBlock Text="{Binding DayText}" FontSize="11.5" Foreground="{StaticResource FaintBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13.5"/>
                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Margin="0,7,0,0"
                                     Visibility="{Binding IsNow, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Style="{StaticResource Icon}" Text="&#xE81C;" Margin="10,0,0,0" FontSize="13"
                               ToolTip="{local:T 'Disponible en el archivo (catch-up)'}" Foreground="{StaticResource MutedBrush}"
                               Visibility="{Binding CanCatchup, Converter={StaticResource BoolVis}}"/>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsPast}" Value="True">
                        <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Poster: fills the width it is given and keeps a 2:3 ratio -->
            <DataTemplate x:Key="PosterTemplate">
                <Button Style="{StaticResource CardButton}" Margin="7,8" ToolTip="{Binding Name}">
                    <StackPanel>
                        <local:AspectBox Ratio="1.5" CornerRadius="13">
                            <Grid>
                                <Rectangle Fill="#12FFFFFF"/>
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" Margin="14"
                                           VerticalAlignment="Center" Foreground="{StaticResource FaintBrush}" FontSize="13"/>
                                <local:FadeImage Source="{Binding Image, Converter={StaticResource Img}, ConverterParameter=360}"
                                                 Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Border Background="#B8000000" CornerRadius="8" Padding="7,3" Margin="8"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Visibility="{Binding RatingText, Converter={StaticResource EmptyVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE735;" FontSize="9.5"
                                                   Foreground="White" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding RatingText}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="White" CornerRadius="13" Width="26" Height="26" Margin="8"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Visibility="{Binding IsFavorite, Converter={StaticResource BoolVis}}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE735;" FontSize="11"
                                               Foreground="Black" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </local:AspectBox>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="3,10,3,0" FontSize="13.5"/>
                    </StackPanel>
                </Button>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
