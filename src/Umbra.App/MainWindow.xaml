<Window x:Class="Umbra.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Umbra.App"
        Title="Umbra" Width="1360" Height="840" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBg}"
        Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <Grid x:Name="Root" Background="{StaticResource WindowBg}">

        <!-- Everything except the video is drawn on a canvas scaled to the window (see Ui). -->
        <Grid x:Name="Shell" LayoutTransform="{Binding Transform, Source={x:Static local:Ui.I}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="76"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <ContentControl x:Name="Host" Grid.Row="1" Focusable="False" RenderTransformOrigin="0.5,0.35"/>

            <!-- Top bar -->
            <Grid x:Name="TopBar" Margin="30,0,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <!-- Brand mark: an eclipse, the same shape as the app icon -->
                    <Path Width="26" Height="26" Fill="White" Stretch="None" VerticalAlignment="Center">
                        <Path.Data>
                            <CombinedGeometry GeometryCombineMode="Exclude">
                                <CombinedGeometry.Geometry1>
                                    <EllipseGeometry Center="13,13" RadiusX="13" RadiusY="13"/>
                                </CombinedGeometry.Geometry1>
                                <CombinedGeometry.Geometry2>
                                    <EllipseGeometry Center="18.8,8.5" RadiusX="11.5" RadiusY="11.5"/>
                                </CombinedGeometry.Geometry2>
                            </CombinedGeometry>
                        </Path.Data>
                    </Path>
                    <TextBlock x:Name="BrandText" Text="Umbra" FontFamily="{StaticResource DisplayFont}" FontSize="17.5"
                               FontWeight="SemiBold" Margin="12,0,0,1" VerticalAlignment="Center"/>
                </StackPanel>

                <Border x:Name="NavPill" Grid.Column="1" VerticalAlignment="Center" Background="{StaticResource Surface1}"
                        BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="23" Padding="3"
                        Visibility="Collapsed">
                    <Grid>
                        <Border x:Name="NavThumb" Background="#26FFFFFF" CornerRadius="19" Height="38" Width="0"
                                HorizontalAlignment="Left" Opacity="0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="NavThumbMove"/>
                            </Border.RenderTransform>
                        </Border>
                        <StackPanel x:Name="NavTabs" Orientation="Horizontal">
                            <RadioButton x:Name="NavHome" Style="{StaticResource NavTab}" Tag="&#xE80F;" Content="{local:T 'Inicio'}" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavLive" Style="{StaticResource NavTab}" Tag="&#xE7F4;" Content="{local:T 'Directo'}" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavMovies" Style="{StaticResource NavTab}" Tag="&#xE8B2;" Content="{local:T 'Películas'}" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavSeries" Style="{StaticResource NavTab}" Tag="&#xE8F1;" Content="{local:T 'Series'}" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavLibrary" Style="{StaticResource NavTab}" Tag="&#xE8B7;" Content="{local:T 'Biblioteca'}" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavSearch" Style="{StaticResource NavTab}" Tag="&#xE721;" Content="{local:T 'Buscar'}" Checked="Nav_Checked"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel x:Name="AccountArea" Orientation="Horizontal" Visibility="Collapsed">
                        <RadioButton x:Name="NavAccount" Style="{StaticResource NavIcon}" Height="42" Padding="5,0,6,0"
                                     ToolTip="{local:T 'Cuenta'}" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource Surface3}">
                                    <TextBlock x:Name="AccountInitial" FontFamily="{StaticResource UiFont}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="AccountLabel" FontFamily="{StaticResource UiFont}" FontSize="13.5" MaxWidth="180"
                                           TextTrimming="CharacterEllipsis" Margin="10,0,8,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavDownloads" Style="{StaticResource NavIcon}" Width="42" Height="42" Margin="6,0,0,0"
                                     Content="&#xE896;" ToolTip="{local:T 'Descargas'}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavIcon}" Width="42" Height="42" Margin="6,0,0,0"
                                     Content="&#xE713;" ToolTip="{local:T 'Ajustes'}" Checked="Nav_Checked"/>
                        <Rectangle Width="1" Height="20" Fill="{StaticResource HairlineStrong}" Margin="12,0,8,0"/>
                    </StackPanel>
                    <Button x:Name="MinButton" Style="{StaticResource IconButton}" Content="&#xE921;" FontSize="11"
                            ToolTip="{local:T 'Minimizar'}" Click="Min_Click" Foreground="{StaticResource MutedBrush}"/>
                    <Button x:Name="FullButton" Style="{StaticResource IconButton}" Content="&#xE73F;" FontSize="13"
                            Click="Full_Click" Foreground="{StaticResource MutedBrush}"/>
                    <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="11"
                            ToolTip="{local:T 'Cerrar'}" Click="Close_Click" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Toast -->
            <Border x:Name="ToastHost" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,40"
                    Background="{StaticResource PopupBrush}" BorderBrush="{StaticResource HairlineStrong}" BorderThickness="1"
                    CornerRadius="23" Padding="20,12,24,12" Opacity="0" IsHitTestVisible="False">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToastMove" Y="14"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.5" Color="Black"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToastGlyph" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,11,0"/>
                    <TextBlock x:Name="ToastText" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- The player lives here, in the same window, over the shell. -->
        <Grid x:Name="PlayerLayer" Background="Black" Visibility="Collapsed" Opacity="0"/>
    </Grid>
</Window>
