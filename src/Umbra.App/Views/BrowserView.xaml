<UserControl x:Class="Umbra.App.BrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Umbra.App">
    <Grid x:Name="Layout" Margin="42,10,28,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="CategoryColumn" Width="270"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.ColumnSpan="2" Margin="6,0,14,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <TextBlock x:Name="PageTitle" Style="{StaticResource LargeTitle}"/>
                <TextBlock x:Name="CountText" Style="{StaticResource Caption}" FontSize="14" Margin="1,3,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <local:Picker x:Name="Sort" Height="44" ToolTip="{local:T 'Ordenar'}"
                              Options="Orden del proveedor=0|Nombre (A-Z)=1|Añadidas recientemente=2|Mejor valoradas=3"/>
                <local:SearchBox x:Name="Filter" Placeholder="Buscar" Width="260" Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Categories -->
        <ListBox x:Name="Categories" Grid.Row="1" Margin="0,0,10,34" ItemTemplate="{StaticResource CategoryTemplate}"
                 SelectionChanged="Categories_SelectionChanged" ContextMenuOpening="Categories_ContextMenuOpening">
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="LockMenuItem" Header="{local:T 'Bloquear categoría'}" Click="LockMenu_Click"/>
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>

        <!-- Posters -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="8,-8,0,0">
            <local:PosterGrid x:Name="Posters"/>
            <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="380">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B2;" FontSize="34" HorizontalAlignment="Center" Foreground="{StaticResource FaintBrush}"/>
                <TextBlock x:Name="EmptyText" Style="{StaticResource Caption}" FontSize="14.5" Margin="0,14,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
