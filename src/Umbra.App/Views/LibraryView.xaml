<UserControl x:Class="Umbra.App.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Umbra.App">
    <UserControl.Resources>
        <!-- A downloaded movie, or a series with its downloaded episodes -->
        <DataTemplate x:Key="TileTemplate">
            <Button Style="{StaticResource CardButton}" Margin="7,8" ToolTip="{Binding Name}" Click="Tile_Click" Tag="{Binding}">
                <Button.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{local:T 'Eliminar del disco'}" Click="TileDelete_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
                <StackPanel>
                    <local:AspectBox Ratio="1.5" CornerRadius="13">
                        <Grid>
                            <Rectangle Fill="#12FFFFFF"/>
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" Margin="14"
                                       VerticalAlignment="Center" Foreground="{StaticResource FaintBrush}" FontSize="13"/>
                            <local:FadeImage Source="{Binding Image, Converter={StaticResource Img}, ConverterParameter=360}"
                                             Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <!-- Chosen for export -->
                            <Border BorderBrush="White" BorderThickness="2" CornerRadius="13" Background="#59000000"
                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolVis}}"/>
                            <Border Background="White" CornerRadius="14" Width="28" Height="28" Margin="9"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolVis}}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="13" Foreground="Black"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </local:AspectBox>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="3,10,3,0" FontSize="13.5"/>
                    <TextBlock Text="{Binding Caption}" Style="{StaticResource Caption}" FontSize="12" Margin="3,2,3,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>
        </DataTemplate>
        <Style x:Key="TileCell" TargetType="ContentPresenter">
            <Setter Property="Width" Value="190"/>
        </Style>
        <ItemsPanelTemplate x:Key="TilePanel">
            <WrapPanel/>
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Page" Margin="48,10,48,60">
            <Button x:Name="BackButton" Style="{StaticResource GlassIconButton}" Content="&#xE72B;" HorizontalAlignment="Left"
                    Width="46" Height="46" Margin="0,0,0,18" ToolTip="{local:T 'Volver (Esc)'}" Click="Back_Click" Visibility="Collapsed"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TitleText" Style="{StaticResource LargeTitle}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SummaryText" Style="{StaticResource Caption}" FontSize="13.5" Margin="1,4,0,0"/>
                    <!-- Only for a series: what was saved about it with its episodes -->
                    <TextBlock x:Name="SeriesMetaText" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="1,12,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="SeriesPlotText" TextWrapping="Wrap" FontSize="14.5" LineHeight="23" MaxWidth="840" HorizontalAlignment="Left"
                               Foreground="#E6F5F5F7" Margin="1,10,16,0" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel x:Name="Actions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AccountsButton" Style="{StaticResource AccentButton}" Padding="20,10" FontSize="13.5" Margin="0,0,8,0"
                            Click="Accounts_Click" Visibility="Collapsed" ToolTip="{local:T 'Entra con una cuenta o añade una lista para ver todo el catálogo'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" Margin="0,0,9,0"/>
                            <TextBlock Text="{local:T 'Abrir una lista'}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ImportButton" Style="{StaticResource SubtleButton}" Padding="18,10" FontSize="13.5" Margin="0,0,8,0"
                            Click="Import_Click" ToolTip="{local:T 'Añade a la biblioteca un .zip exportado desde Umbra'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B5;" Margin="0,0,9,0"/>
                            <TextBlock Text="{local:T 'Importar'}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ExportButton" Style="{StaticResource SubtleButton}" Padding="18,10" FontSize="13.5" Margin="0,0,8,0"
                            Click="Export_Click" ToolTip="{local:T 'Guarda en un .zip los vídeos con su ficha y carátula, sin ningún dato de tu cuenta'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEDE1;" Margin="0,0,9,0"/>
                            <TextBlock Text="{local:T 'Exportar'}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SubtleButton}" Padding="18,10" FontSize="13.5" Click="OpenFolder_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" Margin="0,0,9,0"/>
                            <TextBlock Text="{local:T 'Abrir carpeta'}"/>
                        </StackPanel>
                    </Button>
                    <!-- With an account open the settings are in the navigation bar -->
                    <Button x:Name="SettingsButton" Style="{StaticResource GlassIconButton}" Content="&#xE713;" Width="42" Height="42"
                            Margin="8,0,0,0" ToolTip="{local:T 'Ajustes'}" Click="Settings_Click" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>

            <!-- Choosing what goes into the .zip -->
            <Border x:Name="SelectBar" Style="{StaticResource Card}" Padding="20,12,12,12" Margin="0,22,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SelectText" FontSize="14.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="{local:T 'Seleccionar todo'}" Style="{StaticResource GhostButton}" Click="SelectAll_Click"/>
                        <Button Content="{local:T 'Cancelar'}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="CancelSelect_Click"/>
                        <Button x:Name="ExportSelectedButton" Style="{StaticResource AccentButton}" Padding="22,10" FontSize="13.5"
                                Click="ExportSelected_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Export or import under way -->
            <Border x:Name="BusyBar" Style="{StaticResource Card}" Padding="20,14" Margin="0,22,0,0" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <local:Spinner Width="18" Height="18"/>
                        <TextBlock x:Name="BusyText" FontSize="14.5" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ProgressBar x:Name="BusyProgress" Height="4" Margin="0,12,0,0" Maximum="1"/>
                </StackPanel>
            </Border>

            <Border x:Name="EmptyPanel" Style="{StaticResource Card}" Padding="28,44" Margin="0,24,0,0" MaxWidth="980"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="30" HorizontalAlignment="Center"
                               Foreground="{StaticResource FaintBrush}"/>
                    <TextBlock Text="{local:T 'Tu biblioteca está vacía'}" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    <TextBlock Text="{local:T 'Aquí aparecen las películas y los episodios que descargues, para verlos sin conexión y sin abrir ninguna lista.'}"
                               Style="{StaticResource Caption}" FontSize="13.5" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="MoviesSection" Margin="0,30,0,0" Visibility="Collapsed">
                <TextBlock Text="{local:T 'Películas'}" Style="{StaticResource H2}" Margin="2,0,0,4"/>
                <ItemsControl x:Name="MoviesList" Margin="-7,0,-7,0" Focusable="False" ItemTemplate="{StaticResource TileTemplate}"
                              ItemContainerStyle="{StaticResource TileCell}" ItemsPanel="{StaticResource TilePanel}"/>
            </StackPanel>

            <StackPanel x:Name="SeriesSection" Margin="0,30,0,0" Visibility="Collapsed">
                <TextBlock Text="{local:T 'Series'}" Style="{StaticResource H2}" Margin="2,0,0,4"/>
                <ItemsControl x:Name="SeriesList" Margin="-7,0,-7,0" Focusable="False" ItemTemplate="{StaticResource TileTemplate}"
                              ItemContainerStyle="{StaticResource TileCell}" ItemsPanel="{StaticResource TilePanel}"/>
            </StackPanel>

            <!-- The episodes of one series -->
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition MaxWidth="980"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ItemsControl x:Name="EpisodesList" Margin="0,24,0,0" Focusable="False" Visibility="Collapsed">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <local:AspectBox Ratio="1.5" CornerRadius="10" VerticalAlignment="Center">
                                    <Grid>
                                        <Rectangle Fill="{StaticResource Surface2}"/>
                                        <local:FadeImage Source="{Binding Image, Mode=OneTime, Converter={StaticResource Img}, ConverterParameter=160}" Stretch="UniformToFill"/>
                                    </Grid>
                                </local:AspectBox>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,14,0">
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="13" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Subtitle, Converter={StaticResource EmptyVis}}"/>
                                    <TextBlock Text="{Binding Info.Plot}" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,6,0,0"
                                               TextWrapping="Wrap" MaxHeight="54" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Info.Plot, Converter={StaticResource EmptyVis}, FallbackValue=Collapsed}"/>
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GlassIconButton}" Content="&#xF5B0;" FontSize="13" Margin="6,0,0,0"
                                            ToolTip="{local:T 'Reproducir'}" Click="Episode_Click" Tag="{Binding}"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="15" Margin="6,0,0,0"
                                            Foreground="{StaticResource MutedBrush}"
                                            ToolTip="{local:T 'Eliminar'}" Click="EpisodeDelete_Click" Tag="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
