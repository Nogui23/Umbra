<UserControl x:Class="Umbra.App.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Umbra.App">
    <UserControl.Resources>
        <!-- «Seguir viendo»: a movie or a series, with where it was left («Desde 52:10», «T2 E5») -->
        <DataTemplate x:Key="ResumeTemplate">
            <Button Style="{StaticResource CardButton}" Margin="7,8" ToolTip="{Binding Name}">
                <StackPanel>
                    <local:AspectBox Ratio="1.5" CornerRadius="13">
                        <Grid>
                            <Rectangle Fill="#12FFFFFF"/>
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" Margin="14"
                                       VerticalAlignment="Center" Foreground="{StaticResource FaintBrush}" FontSize="13"/>
                            <local:FadeImage Source="{Binding Image, Converter={StaticResource Img}, ConverterParameter=360}"
                                             Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Border Background="#D9000000" CornerRadius="8" Padding="8,3" Margin="8"
                                    HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding Note}" FontSize="11.5" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                        </Grid>
                    </local:AspectBox>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="3,10,3,0" FontSize="13.5"/>
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Page" Margin="48,14,48,60">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="Greeting" Style="{StaticResource LargeTitle}" FontSize="44"/>
                    <TextBlock x:Name="SubGreeting" Foreground="{StaticResource MutedBrush}" FontSize="16" Margin="2,6,0,0"/>
                </StackPanel>
                <!-- Connections the account has free right now; only for providers that report a limit -->
                <Button x:Name="ConnectionsPill" Grid.Column="1" Style="{StaticResource SubtleButton}" Padding="16,10"
                        VerticalAlignment="Bottom" Margin="16,0,0,2" Visibility="Collapsed" Click="Connections_Click">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ConnectionsDot" Width="9" Height="9" Margin="0,1,10,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ConnectionsText" FontSize="13.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Three big doors into the catalogue -->
            <UniformGrid x:Name="Quick" Rows="1" Margin="-8,30,-8,0">
                <Button Style="{StaticResource TileButton}" Background="{StaticResource Surface1}" Padding="24,22" Margin="8"
                        Tag="NavLive" Click="Quick_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="54" Height="54" CornerRadius="27" Background="{StaticResource Surface2}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="21" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="18,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{local:T 'TV en directo'}" Style="{StaticResource H2}" FontSize="19" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="LiveCount" Style="{StaticResource Caption}" FontSize="13.5" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="13" Foreground="{StaticResource FaintBrush}"/>
                    </Grid>
                </Button>
                <Button Style="{StaticResource TileButton}" Background="{StaticResource Surface1}" Padding="24,22" Margin="8"
                        Tag="NavMovies" Click="Quick_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="54" Height="54" CornerRadius="27" Background="{StaticResource Surface2}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B2;" FontSize="21" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="18,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{local:T 'Películas'}" Style="{StaticResource H2}" FontSize="19" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="MovieCount" Style="{StaticResource Caption}" FontSize="13.5" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="13" Foreground="{StaticResource FaintBrush}"/>
                    </Grid>
                </Button>
                <Button Style="{StaticResource TileButton}" Background="{StaticResource Surface1}" Padding="24,22" Margin="8"
                        Tag="NavSeries" Click="Quick_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="54" Height="54" CornerRadius="27" Background="{StaticResource Surface2}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" FontSize="21" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="18,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{local:T 'Series'}" Style="{StaticResource H2}" FontSize="19" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="SeriesCount" Style="{StaticResource Caption}" FontSize="13.5" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="13" Foreground="{StaticResource FaintBrush}"/>
                    </Grid>
                </Button>
            </UniformGrid>

            <StackPanel x:Name="Shelves"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
