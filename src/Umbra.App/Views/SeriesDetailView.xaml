<UserControl x:Class="Umbra.App.SeriesDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Umbra.App">
    <Grid>
        <Grid Margin="0,-76,0,0" Height="700" VerticalAlignment="Top" IsHitTestVisible="False" ClipToBounds="True">
            <local:FadeImage x:Name="Backdrop" Stretch="UniformToFill" VerticalAlignment="Top" Margin="-40"/>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#D1050506" Offset="0"/>
                        <GradientStop Color="#B8050506" Offset="0.4"/>
                        <GradientStop Color="#FF050506" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Page" Margin="48,8,48,56">
                <Button Style="{StaticResource GlassIconButton}" Content="&#xE72B;" HorizontalAlignment="Left" Width="46" Height="46"
                        ToolTip="{local:T 'Volver (Esc)'}" Click="Back_Click"/>
                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="PosterColumn" Width="230"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <local:AspectBox x:Name="PosterBox" Ratio="1.5" CornerRadius="20" VerticalAlignment="Top">
                        <Grid>
                            <Rectangle Fill="{StaticResource Surface2}"/>
                            <local:FadeImage x:Name="Cover" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </local:AspectBox>
                    <StackPanel x:Name="Info" Grid.Column="1" Margin="44,6,0,0">
                        <TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFont}" FontSize="46" FontWeight="Bold"
                                   TextWrapping="Wrap" LineHeight="52" MaxWidth="900" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="MetaText" Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="2,10,0,0" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,24,0,10">
                            <Button x:Name="PlayButton" Style="{StaticResource AccentButton}" Padding="28,14" Margin="0,0,10,10" Click="PlayNext_Click" IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xF5B0;" FontSize="12" Margin="0,1,10,0"/>
                                    <TextBlock x:Name="PlayText" Text="{local:T 'Reproducir'}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SubtleButton}" Padding="22,14" Margin="0,0,10,10" Click="Fav_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="FavIcon" Style="{StaticResource Icon}" Text="&#xE734;" Margin="0,0,9,0"/>
                                    <TextBlock x:Name="FavText" Text="{local:T 'Favorita'}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="SeasonDownloadButton" Style="{StaticResource SubtleButton}" Padding="22,14" Margin="0,0,10,10"
                                    Click="SeasonDownload_Click" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Margin="0,0,9,0"/>
                                    <TextBlock x:Name="SeasonDownloadText" Text="{local:T 'Descargar temporada'}"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock x:Name="PlotText" TextWrapping="Wrap" FontSize="15.5" LineHeight="25" MaxWidth="840" HorizontalAlignment="Left"
                                   Foreground="#E6F5F5F7"/>
                        <TextBlock x:Name="CastText" TextWrapping="Wrap" FontSize="13.5" LineHeight="21" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,14,0,0" MaxWidth="840" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" Margin="2,34,0,0">
                    <local:Spinner x:Name="LoadingSpinner" Width="18" Height="18"/>
                    <TextBlock x:Name="LoadingText" Text="{local:T 'Cargando temporadas…'}" Style="{StaticResource Caption}" FontSize="13.5" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="EpisodesTitle" Text="{local:T 'Episodios'}" Style="{StaticResource H2}" Margin="2,40,0,14" Visibility="Collapsed"/>
                <WrapPanel x:Name="Seasons" Margin="0,0,0,10"/>
                <ItemsControl x:Name="Episodes" Margin="-8,0,-8,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TileButton}" Margin="0,0,0,4" Padding="8" Click="Episode_Click" Tag="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="214"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <local:AspectBox Ratio="0.5625" CornerRadius="12">
                                        <Grid>
                                            <Rectangle Fill="{StaticResource Surface2}"/>
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xF5B0;" FontSize="20" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource FaintBrush}"/>
                                            <local:FadeImage Source="{Binding Image, Converter={StaticResource Img}, ConverterParameter=428}" Stretch="UniformToFill"/>
                                            <ProgressBar VerticalAlignment="Bottom" Height="4" Margin="10,0,10,9" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                                                         Background="#66000000"
                                                         Visibility="{Binding Progress, Converter={StaticResource PositiveVis}}"/>
                                        </Grid>
                                    </local:AspectBox>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="22,0,12,0">
                                        <TextBlock Text="{Binding DisplayTitle}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DurationText}" Style="{StaticResource Caption}" Margin="0,3,0,0"
                                                   Visibility="{Binding DurationText, Converter={StaticResource EmptyVis}}"/>
                                        <TextBlock Text="{Binding Plot}" TextWrapping="Wrap" MaxHeight="42" LineHeight="20" TextTrimming="WordEllipsis"
                                                   Foreground="{StaticResource MutedBrush}" FontSize="13.5" MaxWidth="900" HorizontalAlignment="Left"
                                                   Margin="0,7,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" VerticalAlignment="Center" Margin="12,0,14,0" Background="{StaticResource Surface2}"
                                            CornerRadius="13" Padding="11,5,13,5"
                                            Visibility="{Binding Watched, Converter={StaticResource BoolVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="11" Margin="0,0,7,0"/>
                                            <TextBlock Text="{local:T 'Visto'}" FontSize="12.5"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Grid.Column="3" Style="{StaticResource IconButton}" VerticalAlignment="Center" Margin="0,0,8,0"
                                            Click="EpisodeDownload_Click" Tag="{Binding}" ToolTip="{local:T 'Descargar'}">
                                        <Grid>
                                            <TextBlock x:Name="DownloadGlyph" Text="&#xE896;" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock x:Name="DownloadBadge" Text="{Binding Download.Badge}" FontFamily="{StaticResource UiFont}"
                                                       FontSize="11.5" FontWeight="SemiBold" Visibility="Collapsed"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Download.IsActive}" Value="True">
                                    <Setter TargetName="DownloadGlyph" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="DownloadBadge" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Download.IsCompleted}" Value="True">
                                    <Setter TargetName="DownloadGlyph" Property="Text" Value="&#xE73E;"/>
                                    <Setter TargetName="DownloadGlyph" Property="Foreground" Value="{StaticResource TextBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
