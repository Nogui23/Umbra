<UserControl x:Class="Umbra.App.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Umbra.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Page" Margin="40,10,40,60" MaxWidth="980">
            <Grid Margin="6,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{local:T 'Descargas'}" Style="{StaticResource LargeTitle}"/>
                    <TextBlock x:Name="SummaryText" Style="{StaticResource Caption}" FontSize="13.5" Margin="1,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SubtleButton}" Padding="18,10" FontSize="13.5" VerticalAlignment="Center"
                        Click="OpenFolder_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" Margin="0,0,9,0"/>
                        <TextBlock Text="{local:T 'Abrir carpeta'}"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Border x:Name="EmptyPanel" Style="{StaticResource Card}" Padding="28,44" Margin="0,24,0,0" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="30" HorizontalAlignment="Center"
                               Foreground="{StaticResource FaintBrush}"/>
                    <TextBlock Text="{local:T 'Todavía no has descargado nada'}" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    <TextBlock Text="{local:T 'Abre una película o una serie y pulsa «Descargar» para verla sin conexión.'}"
                               Style="{StaticResource Caption}" FontSize="13.5" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <ItemsControl x:Name="List" Margin="0,24,0,0" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <local:AspectBox Ratio="1.5" CornerRadius="10" VerticalAlignment="Center">
                                    <Grid>
                                        <Rectangle Fill="{StaticResource Surface2}"/>
                                        <local:FadeImage Source="{Binding Image, Mode=OneTime, Converter={StaticResource Img}, ConverterParameter=160}" Stretch="UniformToFill"/>
                                    </Grid>
                                </local:AspectBox>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,14,0">
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="13" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Subtitle, Converter={StaticResource EmptyVis}}"/>
                                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,6,0,0"
                                               TextWrapping="Wrap"/>
                                    <ProgressBar Height="4" Margin="0,9,0,0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                                                 Visibility="{Binding ShowProgress, Converter={StaticResource BoolVis}}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GlassIconButton}" Content="&#xF5B0;" FontSize="13" Margin="6,0,0,0"
                                            ToolTip="{local:T 'Reproducir'}" Click="Play_Click" Tag="{Binding}"
                                            Visibility="{Binding IsCompleted, Converter={StaticResource BoolVis}}"/>
                                    <Button Style="{StaticResource GlassIconButton}" Content="&#xE769;" FontSize="14" Margin="6,0,0,0"
                                            ToolTip="{local:T 'Pausar'}" Click="Pause_Click" Tag="{Binding}"
                                            Visibility="{Binding CanPause, Converter={StaticResource BoolVis}}"/>
                                    <Button Style="{StaticResource GlassIconButton}" Content="&#xE72C;" FontSize="14" Margin="6,0,0,0"
                                            ToolTip="{local:T 'Reanudar'}" Click="Resume_Click" Tag="{Binding}"
                                            Visibility="{Binding CanResume, Converter={StaticResource BoolVis}}"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="15" Margin="6,0,0,0"
                                            Foreground="{StaticResource MutedBrush}"
                                            ToolTip="{local:T 'Eliminar'}" Click="Delete_Click" Tag="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
