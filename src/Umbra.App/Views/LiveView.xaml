<UserControl x:Class="Umbra.App.LiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Umbra.App">
    <Grid x:Name="Layout" Margin="42,10,42,34">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="CategoryColumn" Width="270"/>
            <ColumnDefinition Width="*" MinWidth="280"/>
            <ColumnDefinition x:Name="DetailColumn" Width="440"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.ColumnSpan="2" Margin="6,0,28,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="{local:T 'TV en directo'}" Style="{StaticResource LargeTitle}"/>
                <TextBlock x:Name="CountText" Style="{StaticResource Caption}" FontSize="14" Margin="1,3,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <local:SearchBox x:Name="Filter" Grid.Column="1" Placeholder="Buscar canal" Width="280" VerticalAlignment="Bottom"/>
        </Grid>

        <!-- Categories -->
        <ListBox x:Name="Categories" Grid.Row="1" Margin="0,0,10,0" ItemTemplate="{StaticResource CategoryTemplate}"
                 SelectionChanged="Categories_SelectionChanged" ContextMenuOpening="Categories_ContextMenuOpening">
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="LockMenuItem" Header="{local:T 'Bloquear categoría'}" Click="LockMenu_Click"/>
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>

        <!-- Channels -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="8,0,16,0">
            <ListBox x:Name="Channels" ItemTemplate="{StaticResource ChannelRowTemplate}"
                     SelectionChanged="Channels_SelectionChanged" MouseDoubleClick="Channels_MouseDoubleClick"
                     KeyDown="Channels_KeyDown" ButtonBase.Click="Channels_ButtonClick"/>
            <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="360">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="34" HorizontalAlignment="Center" Foreground="{StaticResource FaintBrush}"/>
                <TextBlock x:Name="EmptyText" Style="{StaticResource Caption}" FontSize="14.5" Margin="0,14,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- Selected channel: actions and programme guide -->
        <Border x:Name="DetailCard" Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource Card}" Padding="24">
            <Grid>
                <DockPanel x:Name="DetailPanel" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top">
                        <Border Height="150" CornerRadius="16" Background="#0FFFFFFF">
                            <local:FadeImage x:Name="DetailLogo" Stretch="Uniform" Margin="44,30" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock x:Name="DetailName" FontFamily="{StaticResource DisplayFont}" FontSize="23" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="2,18,0,0"/>
                        <TextBlock x:Name="DetailInfo" Style="{StaticResource Caption}" FontSize="13" Margin="2,3,0,0"/>
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource AccentButton}" Click="Play_Click" Padding="24,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xF5B0;" FontSize="12" Margin="0,1,9,0"/>
                                    <TextBlock Text="{local:T 'Ver ahora'}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="FavButton" Grid.Column="1" Style="{StaticResource GlassIconButton}" Width="46" Height="46"
                                    Margin="10,0,0,0" Content="&#xE734;" Click="Fav_Click" ToolTip="{local:T 'Añadir a favoritos'}"/>
                        </Grid>
                        <TextBlock Text="{local:T 'Programación'}" Style="{StaticResource H3}" Margin="2,26,0,6"/>
                    </StackPanel>

                    <Border x:Name="ProgramBox" DockPanel.Dock="Bottom" Background="{StaticResource Surface1}" CornerRadius="16"
                            Padding="16,14" Margin="0,12,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="ProgramTitle" FontWeight="SemiBold" FontSize="14.5" TextWrapping="Wrap"/>
                            <TextBlock x:Name="ProgramTime" Style="{StaticResource Caption}" Margin="0,3,0,7"/>
                            <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="ProgramDesc" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="13.5"
                                           LineHeight="20" Margin="0,0,12,0"/>
                            </ScrollViewer>
                            <Button x:Name="CatchupButton" Style="{StaticResource SubtleButton}" Margin="0,12,0,0" HorizontalAlignment="Left"
                                    Padding="16,8" FontSize="13.5" Click="Catchup_Click" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" Margin="0,0,8,0"/>
                                    <TextBlock Text="{local:T 'Ver desde el archivo'}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Grid Margin="-8,0,-10,0">
                        <ListBox x:Name="Epg" ItemTemplate="{StaticResource EpgTemplate}"
                                 SelectionChanged="Epg_SelectionChanged" MouseDoubleClick="Epg_MouseDoubleClick"/>
                        <StackPanel x:Name="EpgStatusPanel" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,26,0,0">
                            <local:Spinner x:Name="EpgSpinner" Width="24" Height="24" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="EpgStatus" Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap"
                                       TextAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>

                <StackPanel x:Name="NoSelection" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="38" HorizontalAlignment="Center" Foreground="{StaticResource FaintBrush}"/>
                    <TextBlock Text="{local:T 'Elige un canal para ver su programación.'}" Style="{StaticResource Caption}" FontSize="14" Margin="0,14,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
