<UserControl x:Class="Umbra.App.LoadingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Umbra.App">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="460" Margin="0,0,0,76">
        <Border Width="92" Height="92" CornerRadius="46" Background="{StaticResource Surface3}" HorizontalAlignment="Center">
            <TextBlock x:Name="InitialText" FontFamily="{StaticResource DisplayFont}" FontSize="38" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock x:Name="AccountText" Style="{StaticResource H2}" FontSize="24" HorizontalAlignment="Center" Margin="0,22,0,0"
                   TextTrimming="CharacterEllipsis"/>
        <local:Spinner Width="30" Height="30" HorizontalAlignment="Center" Margin="0,34,0,0"/>
        <TextBlock x:Name="StatusText" Text="{local:T 'Conectando…'}" Foreground="{StaticResource MutedBrush}" FontSize="14.5"
                   HorizontalAlignment="Center" Margin="0,16,0,0" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
</UserControl>
