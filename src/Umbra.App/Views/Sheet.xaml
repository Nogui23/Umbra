<Window x:Class="Umbra.App.Sheet"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Umbra.App"
        Title="Umbra" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="Manual"
        Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <!-- Covers the main window: a dimmed backdrop with the dialog card in the middle. -->
    <Grid x:Name="Backdrop" Background="#A6000000" Opacity="0">
        <Grid LayoutTransform="{Binding Transform, Source={x:Static local:Ui.I}}" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border x:Name="CardHost" Width="430" Background="{StaticResource PopupBrush}" BorderBrush="{StaticResource HairlineStrong}"
                    BorderThickness="1" CornerRadius="26" Padding="32,30,32,26" Margin="40">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.6" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <Border Width="54" Height="54" CornerRadius="27" Background="{StaticResource Surface2}" HorizontalAlignment="Center">
                        <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="&#xE946;" FontSize="22" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TitleText" Style="{StaticResource H2}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,18,0,0"/>
                    <TextBlock x:Name="MessageText" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap"
                               FontSize="14" LineHeight="21" Margin="0,8,0,0"/>
                    <PasswordBox x:Name="PinBox" MaxLength="12" Margin="0,20,0,0" HorizontalContentAlignment="Center"
                                 FontSize="20" Visibility="Collapsed"/>
                    <Grid Margin="0,26,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="CancelColumn"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CancelButton" Content="{local:T 'Cancelar'}" IsCancel="True" Style="{StaticResource SubtleButton}"
                                Margin="0,0,6,0" Click="Cancel_Click"/>
                        <Button x:Name="OkButton" Grid.Column="1" Content="{local:T 'Aceptar'}" IsDefault="True" Style="{StaticResource AccentButton}"
                                Margin="6,0,0,0" Click="Ok_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
