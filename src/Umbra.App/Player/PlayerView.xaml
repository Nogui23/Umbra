<UserControl x:Class="Umbra.App.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             xmlns:local="clr-namespace:Umbra.App"
             Background="Black" Focusable="False">
    <vlc:VideoView x:Name="Video" Background="Black">
        <!-- The overlay is composited over the video surface; it fills the window, its content is scaled like the shell. -->
        <Grid x:Name="Overlay" Background="#01000000" Focusable="True" FocusVisualStyle="{x:Null}"
              TextElement.Foreground="White" TextElement.FontFamily="{StaticResource UiFont}" TextElement.FontSize="14"
              UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
              MouseMove="Overlay_MouseMove" MouseLeftButtonDown="Overlay_MouseLeftButtonDown" MouseWheel="Overlay_MouseWheel">
            <Grid LayoutTransform="{Binding Transform, Source={x:Static local:Ui.I}}">

                <!-- Play / pause feedback in the middle of the picture -->
                <Border x:Name="CenterBadge" Width="104" Height="104" CornerRadius="52" Background="#73000000"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="CenterScale" ScaleX="0.8" ScaleY="0.8"/>
                    </Border.RenderTransform>
                    <Path x:Name="CenterGlyph" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Width="32" Height="34"/>
                </Border>

                <!-- Loading / error -->
                <Border x:Name="StatusPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#B80C0C0E"
                        BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="22" Padding="30,24" MaxWidth="620" IsHitTestVisible="True">
                    <StackPanel>
                        <local:Spinner x:Name="StatusSpinner" Width="34" Height="34" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" FontSize="15" TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,0"/>
                        <Button x:Name="RetryButton" Content="{local:T 'Reintentar'}" Style="{StaticResource AccentButton}" Margin="0,18,0,0"
                                HorizontalAlignment="Center" Click="Retry_Click" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Auto-hiding controls -->
                <Grid x:Name="ControlsLayer">
                    <Rectangle VerticalAlignment="Top" Height="190" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#D9000000" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle VerticalAlignment="Bottom" Height="250" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#CC000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Grid x:Name="TopBar" VerticalAlignment="Top" Margin="28,24,28,0">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="TopMove"/>
                        </Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource GlassIconButton}" Background="#8C1C1C1E" Width="46" Height="46" Content="&#xE72B;" FontSize="16"
                                ToolTip="{local:T 'Volver (Esc)'}" Click="Close_Click" VerticalAlignment="Top" Foreground="White"/>
                        <StackPanel Grid.Column="1" Margin="18,2,0,0" VerticalAlignment="Top">
                            <TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="SubtitleText" Foreground="#CCFFFFFF" FontSize="13.5" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="BottomBar" VerticalAlignment="Bottom" Margin="28,0,28,28" MaxWidth="1240" CornerRadius="26" Padding="24,14,24,12"
                            Background="#DB131315" BorderBrush="#26FFFFFF" BorderThickness="1">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="BottomMove"/>
                        </Border.RenderTransform>
                        <StackPanel>
                            <!-- Movies and episodes: seek bar -->
                            <Grid x:Name="SeekRow" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TimeText" FontSize="12.5" VerticalAlignment="Center" MinWidth="54" Text="0:00" Foreground="#D9FFFFFF"/>
                                <Slider x:Name="Seek" Grid.Column="1" Minimum="0" Maximum="1" Margin="10,0" IsMoveToPointEnabled="True"
                                        VerticalAlignment="Center" Focusable="False" ValueChanged="Seek_ValueChanged"
                                        PreviewMouseLeftButtonDown="Seek_PreviewMouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="Seek_PreviewMouseLeftButtonUp"/>
                                <TextBlock x:Name="LengthText" Grid.Column="2" FontSize="12.5" VerticalAlignment="Center" MinWidth="54"
                                           TextAlignment="Right" Text="0:00" Foreground="#D9FFFFFF"/>
                            </Grid>
                            <!-- Live TV: progress of the programme on air -->
                            <Grid x:Name="LiveRow" Margin="0,2,0,10" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="White" CornerRadius="7" Padding="9,4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="LiveDot" Width="6" Height="6" Fill="Black" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{local:T 'EN DIRECTO'}" FontWeight="Bold" FontSize="10.5" Foreground="Black"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="NowStart" Grid.Column="1" FontSize="12.5" Foreground="#D9FFFFFF" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                <ProgressBar x:Name="NowProgress" Grid.Column="2" Maximum="1" Height="4" Margin="12,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NowEnd" Grid.Column="3" FontSize="12.5" Foreground="#D9FFFFFF" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Button x:Name="ChannelsButton" Style="{StaticResource IconButton}" Foreground="White" Content="&#xE8FD;" ToolTip="{local:T 'Lista de canales (C)'}" Click="Channels_Click"/>
                                    <Button x:Name="AudioButton" Style="{StaticResource IconButton}" Foreground="White" Content="&#xE8D6;" ToolTip="{local:T 'Pista de audio'}" Click="Audio_Click"/>
                                    <Button x:Name="SubsButton" Style="{StaticResource IconButton}" Foreground="White" Content="&#xED1E;" ToolTip="{local:T 'Subtítulos'}" Click="Subs_Click"/>
                                    <Button x:Name="AspectButton" Style="{StaticResource IconButton}" Foreground="White" Content="&#xE799;" ToolTip="{local:T 'Formato de imagen (A)'}" Click="Aspect_Click"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Foreground="White" Content="&#xE892;" FontSize="17" ToolTip="{local:T 'Anterior (Re Pág)'}" Click="Prev_Click"/>
                                    <Button x:Name="BackButton10" Style="{StaticResource IconButton}" Foreground="White" Content="&#xED3C;" FontSize="18" ToolTip="{local:T 'Retroceder 10 s (←)'}" Click="Back10_Click"/>
                                    <Button x:Name="PlayPauseButton" Style="{StaticResource AccentButton}" Width="54" Height="54" Padding="0" Margin="10,0"
                                            ToolTip="{local:T 'Reproducir / pausa (Espacio)'}" Click="PlayPause_Click">
                                        <Path x:Name="PlayGlyph" Fill="Black" Stretch="Uniform" Width="17" Height="18"/>
                                    </Button>
                                    <Button x:Name="Forward30" Style="{StaticResource IconButton}" Foreground="White" Content="&#xED3D;" FontSize="18" ToolTip="{local:T 'Avanzar 30 s (→)'}" Click="Forward30_Click"/>
                                    <Button x:Name="NextButton" Style="{StaticResource IconButton}" Foreground="White" Content="&#xE893;" FontSize="17" ToolTip="{local:T 'Siguiente (Av Pág)'}" Click="Next_Click"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Foreground="White" Content="&#xE767;" ToolTip="{local:T 'Silenciar (M)'}" Click="Mute_Click"/>
                                    <Slider x:Name="Volume" Width="116" Minimum="0" Maximum="150" VerticalAlignment="Center" Focusable="False"
                                            IsMoveToPointEnabled="True" ValueChanged="Volume_ValueChanged" Margin="2,0,12,0"/>
                                    <Button x:Name="FullscreenButton" Style="{StaticResource IconButton}" Foreground="White" Content="&#xE740;" ToolTip="{local:T 'Pantalla completa (F)'}" Click="Fullscreen_Click"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Channel list: slides in from the left -->
                <Border x:Name="ChannelPanel" HorizontalAlignment="Left" Width="410" Margin="20,20,0,20"
                        Background="#FA121214" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="24"
                        Padding="12,6,2,12" Visibility="Collapsed">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ChannelMove" X="-450"/>
                    </Border.RenderTransform>
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="12,14,10,10">
                            <TextBlock Text="{local:T 'Canales'}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource IconButton}" Foreground="White" Width="34" Height="34" FontSize="11" Content="&#xE711;"
                                    HorizontalAlignment="Right" ToolTip="{local:T 'Cerrar (Esc)'}" Click="Channels_Click"/>
                        </Grid>
                        <ListBox x:Name="ChannelList" ItemTemplate="{StaticResource ChannelTemplate}"
                                 MouseDoubleClick="ChannelList_MouseDoubleClick" KeyDown="ChannelList_KeyDown"/>
                    </DockPanel>
                </Border>

                <!-- Toast -->
                <Border x:Name="ToastBorder" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,104,0,0"
                        Background="#D9141416" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="20" Padding="20,10"
                        Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="ToastScale" ScaleX="0.9" ScaleY="0.9"/>
                    </Border.RenderTransform>
                    <TextBlock x:Name="ToastText" FontSize="14.5" FontWeight="Medium"/>
                </Border>
            </Grid>
        </Grid>
    </vlc:VideoView>
</UserControl>
